{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "roomscan/property_plan.schema.json",
  "title": "PropertyPlan",
  "type": "object",
  "required": ["capture_id", "tier", "rooms", "adjacency", "footprint_m2", "warnings"],
  "properties": {
    "capture_id": {"type": "string"},
    "tier": {"enum": ["photo", "video", "lidar"]},
    "rooms": {"type": "array", "items": {"$ref": "#/$defs/room"}},
    "adjacency": {"type": "array", "items": {"type": "array", "items": {"type": "string"}, "minItems": 2, "maxItems": 2}},
    "footprint_m2": {"$ref": "#/$defs/interval"},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "input_quality": {"type": "object"}
  },
  "$defs": {
    "interval": {
      "type": "object",
      "required": ["value", "lo", "hi", "unit", "level"],
      "properties": {
        "value": {"type": "number"}, "lo": {"type": "number"}, "hi": {"type": "number"},
        "unit": {"type": "string"}, "level": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "room": {
      "type": "object",
      "required": ["room_id", "walls", "ceiling_height_m", "floor_area_m2", "openings", "damage", "concealed_flags", "scope"],
      "properties": {
        "room_id": {"type": "string"},
        "walls": {"type": "array", "items": {
          "type": "object", "required": ["start", "end", "length_m"],
          "properties": {"start": {"type": "array"}, "end": {"type": "array"}, "length_m": {"$ref": "#/$defs/interval"}}
        }},
        "ceiling_height_m": {"$ref": "#/$defs/interval"},
        "floor_area_m2": {"$ref": "#/$defs/interval"},
        "openings": {"type": "array", "items": {
          "type": "object", "required": ["kind", "wall_index", "offset_m", "width_m"],
          "properties": {
            "kind": {"enum": ["door", "window", "passage"]},
            "wall_index": {"type": "integer"},
            "offset_m": {"$ref": "#/$defs/interval"},
            "width_m": {"$ref": "#/$defs/interval"},
            "height_m": {"oneOf": [{"$ref": "#/$defs/interval"}, {"type": "null"}]},
            "connects_to_room": {"type": ["string", "null"]},
            "confidence": {"type": "number"}
          }
        }},
        "damage": {"type": "array", "items": {
          "type": "object", "required": ["surface_id", "damage_class", "area_m2"],
          "properties": {"surface_id": {"type": "string"}, "damage_class": {"type": "string"}, "area_m2": {"$ref": "#/$defs/interval"}}
        }},
        "concealed_flags": {"type": "array", "items": {
          "type": "object", "required": ["surface_id", "rule_id", "rationale"]
        }},
        "scope": {"type": "array", "items": {
          "type": "object", "required": ["surface_id", "code", "description", "quantity", "unit"],
          "properties": {"quantity": {"$ref": "#/$defs/interval"}}
        }},
        "origin_xy": {"type": "array"},
        "rotation_deg": {"type": "number"}
      }
    }
  }
}
